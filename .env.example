# Copy this file to .env.local and fill in your own values.
# MongoDB Atlas connection string (database name is part of the URI)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/clean_community?retryWrites=true&w=majority
JWT_SECRET=change_me_to_a_long_random_string_of_at_least_32_chars
# First admin account (created on first request if no admin exists)
ADMIN_EMAIL=admin@cleancommunity.local
ADMIN_PASSWORD=change_me_admin

# Password reset emails (SMTP). Without SMTP_HOST the code is printed to the server console in dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Clean Community <no-reply@yourdomain.com>

# Photo storage (AWS S3). Keep the bucket private.
S3_BUCKET=your-bucket-name
# Folder inside the bucket where photos are stored
S3_PREFIX=cleancommunity
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
